
<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <title>Detalhes do Time</title>
</head>
<body>

    <h1><%= time.nome %></h1>

    <p>
        <strong>ID:</strong>
        <%= time.id %>
    </p>

    <p>
        <strong>Estádio:</strong>
        <%= time.estadio %>
    </p>

    <p>
        <strong>Cidade:</strong>
        <%= time.cidade %>
    </p>

    <a href="/times">Voltar para a lista de times</a>

</body>
</html>
